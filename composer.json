{
    "name": "scheb/two-factor-bundle",
    "type": "symfony-bundle",
    "description": "Provides two-factor authentication for Symfony applications",
    "keywords": [
        "2fa",
        "two-factor",
        "two-step",
        "authentication",
        "symfony"
    ],
    "homepage": "https://github.com/scheb/two-factor-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Christian Scheb",
            "email": "me@christianscheb.de"
        }
    ],
    "require": {
        "php": ">=7.4",
        "symfony/config": "^4.4|^5.4",
        "symfony/dependency-injection": "^4.4|^5.4",
        "symfony/event-dispatcher": "^4.4|^5.4",
        "symfony/framework-bundle": "^4.4|^5.4",
        "symfony/http-foundation": "^4.4|^5.4",
        "symfony/http-kernel": "^4.4|^5.4",
        "symfony/property-access": "^4.4|^5.4",
        "symfony/security-bundle": "^4.4|^5.4",
        "symfony/twig-bundle": "^4.4|^5.4",
        "lcobucci/jwt": "^3.2|^4.0",
        "spomky-labs/otphp": "^9.1|^10.0",
        "paragonie/constant_time_encoding": "^2.2"
    },
    "require-dev": {
        "lexik/jwt-authentication-bundle": "^2.14",
        "doctrine/persistence": "^1.3|^2.0",
        "phpunit/phpunit": "^9.6",
        "swiftmailer/swiftmailer": "^6.0",
        "symfony/yaml": "^4.4|^5.4"
    },
    "autoload": {
        "psr-4": {
            "Scheb\\TwoFactorBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "config": {
        "bin-dir": "bin"
    }
}
